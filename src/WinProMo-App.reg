REGEDIT
; This .REG file may be used by your SETUP program.
;   If a SETUP program is not available, the entries below will be
;   registered in your InitInstance automatically with a call to
;   CWinApp::RegisterShellFileTypes and COleObjectFactory::UpdateRegistryAll.

HKEY_CLASSES_ROOT\.wpo = WinProMo.Document
HKEY_CLASSES_ROOT\WinProMo.Document\shell\open\command = WinProMo-App.EXE %1
HKEY_CLASSES_ROOT\WinProMo.Document\shell\open\ddeexec = [open("%1")]
HKEY_CLASSES_ROOT\WinProMo.Document\shell\open\ddeexec\application = WinProMo-App

; also WINPROMO.WINPROMOAPP that points to 358D499C
    ; note: the application is optional
    ;  (it defaults to the app name in "command")

; Default interface IID for CPROMOAPPAUTO
HKEY_CLASSES_ROOT\Interface\{358D499B-FD35-11F0-9740-000C2976A615} = IWinProMoAuto
HKEY_CLASSES_ROOT\Interface\{358D499B-FD35-11F0-9740-000C2976A615}\ProxyStubClsid32 = {00020424-0000-0000-C000-000000000046}
HKEY_CLASSES_ROOT\Interface\{358D499B-FD35-11F0-9740-000C2976A615}\TypeLib = {C0161100-08C3-11F1-9744-000C2976A615}
HKEY_CLASSES_ROOT\Interface\{358D499B-FD35-11F0-9740-000C2976A615}\TypeLib\Version = 1.0
; has also proxystubclsid

; Coclass CLSID
HKEY_CLASSES_ROOT\CLSID\{358D499C-FD35-11F0-9740-000C2976A615}\Implemented Categories\{62C8FE65-4EBB-45e7-B440-6E39B2CDBF29} = ""
; not in use, uses Inprochandler32, localserver32, progid

[TypeLib\{C0161100-08C3-11F1-9744-000C2976A615}\1.0]
@="WinProMo Application"
"Flags"=dword:0

[TypeLib\{C0161100-08C3-11F1-9744-000C2976A615}\1.0\0\win32]
@="C:\\Path\\To\\WinProMoApp.exe"
;it should point to tlb instead

;helpdir exists