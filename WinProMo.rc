            VALUE "FileDescription", "WINPROMO MFC Application\0"
            VALUE "FileVersion", "1, 0, 0, 1\0"
            VALUE "InternalName", "WINPROMO\0"
            VALUE "LegalCopyright", "Copyright © 1925\0"
            VALUE "OriginalFilename", "WINPROMO.EXE\0"
            VALUE "ProductName", "WINPROMO Application\0"
            VALUE "ProductVersion", "1, 0, 0, 1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

